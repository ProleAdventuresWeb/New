{
  "name": "react_repo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm install --prefer-offline && vite",
    "generate:rss": "tsx scripts/generate-rss.ts",
    "build": "pnpm install --prefer-offline && tsc -b && pnpm run generate:rss && vite build",
    "build:prod": "pnpm install --prefer-offline && tsc -b && pnpm run generate:rss && BUILD_MODE=prod vite build",
    "build:local": "pnpm install --prefer-offline && tsc -b && vite build",
    "lint": "pnpm install --prefer-offline && eslint .",
    "preview": "pnpm install --prefer-offline && vite preview",
    "install-deps": "pnpm install --prefer-offline",
    "clean": "rm -rf node_modules .pnpm-store pnpm-lock.yaml && pnpm store prune"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.0.1",
    "@supabase/supabase-js": "^2.100.0",
    "@types/leaflet": "^1.9.21",
    "clsx": "^2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.3",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260423.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.15",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "tsx": "^4.21.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.4.1",
    "vite-plugin-source-identifier": "1.1.2"
  }
}